set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name DEVICE 10M02SCM153I7G
set_global_assignment -name TOP_LEVEL_ENTITY elevator_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"
set_global_assignment -name SDC_FILE constraints/elevator.sdc
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_WEAK_PULLUP "AS INPUT TRI-STATED"
set_global_assignment -name SYSTEMVERILOG_FILE rtl/button_input.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/elevator_controller.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sevenseg_decoder.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/elevator_top.sv
set_location_assignment PIN_J5 -to clk_12m
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk_12m
set_location_assignment PIN_E2 -to dig1_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to dig1_n
set_location_assignment PIN_L1 -to dp
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to dp
set_location_assignment PIN_B1 -to dig2_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to dig2_n
set_location_assignment PIN_J9 -to key_n[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to key_n[0]
set_location_assignment PIN_K14 -to key_n[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to key_n[1]
set_location_assignment PIN_J11 -to key_n[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to key_n[2]
set_location_assignment PIN_J14 -to key_n[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to key_n[3]
set_location_assignment PIN_E1 -to seg[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to seg[0]
set_location_assignment PIN_D2 -to seg[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to seg[1]
set_location_assignment PIN_K2 -to seg[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to seg[2]
set_location_assignment PIN_J2 -to seg[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to seg[3]
set_location_assignment PIN_G2 -to seg[4]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to seg[4]
set_location_assignment PIN_F5 -to seg[5]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to seg[5]
set_location_assignment PIN_G5 -to seg[6]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to seg[6]

set_global_assignment -name LAST_QUARTUS_VERSION "20.1.0 Lite Edition"

set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_location_assignment PIN_N15 -to led1
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led1

# SW4 is a synchronized active-low emergency input, not a reset.
set_location_assignment PIN_H13 -to emergency_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to emergency_n
set_instance_assignment -name WEAK_PULL_UP_RESISTOR OFF -to emergency_n

set_global_assignment -name SYSTEMVERILOG_FILE rtl/buzzer_tone.sv

set_location_assignment PIN_R14 -to beeper
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to beeper
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top